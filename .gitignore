/target
**/*.rs.bk
Cargo.lock.bak

# Claude Code session state
.claude/

# Local config and secrets
*.local.toml
.env
.env.*
!.env.example

# Real deployment secrets (only the *.example.* templates are committed)
deploy/*.env

# Editor/OS
.idea
.vscode
*.swp
.DS_Store

# mise installs its tools project-locally if asked; tracked separately
.mise.toml.local

# Dev-mode SQLite. Still named `gateway.sqlite`: the filename is a persistent
# path, and renaming it would orphan every existing database (docs/renaming.md).
gateway.sqlite*

# Persistent dev session key, generated on first `mise run dev`. It is a real
# secret (it derives the at-rest key that seals the local DB's stored
# credentials) — never commit it.
.aiplane-dev-session-key
/.playwright-cli/

# Local dev RAG storage: the `[rag] data_dir` tree (default ./data/rag).
# Per-collection sqlite + usearch vector indexes + git clone caches —
# all regenerable and potentially many GB. Never commit.
/data/

# GeoIP database
IP2LOCATION-LITE-DB11.BIN

# Python bytecode cache (e.g. from running/importing sandbox-image/sandbox-agent)
__pycache__/
*.pyc

# Local agent/tool configs — hold personal MCP endpoints and API tokens.
# A token from .codex/config.toml once leaked into the public history; keep
# these untracked so it cannot happen again.
.codex/
