# Copy to /etc/aiplane/aiplane.env and fill in. The Quadlet's
# `EnvironmentFile=` pulls everything in this file into the container's env.
# Permissions: chmod 0600 + chown root:root, since this holds long-lived
# secrets.

# THE ONE REQUIRED VARIABLE. 32 random bytes hex-encoded; the gateway refuses
# to boot without it. Generate once:
#   openssl rand -hex 32
#
# It signs browser sessions AND derives the key that seals every secret stored
# in the database (backend API keys, connector client secrets, per-user OAuth
# tokens). Changing or losing it logs everyone out and makes all of those
# permanently unreadable — treat it as precious as the database itself and back
# the two up together.
AIPLANE_SESSION_KEY=__replace_me__

# Everything below is OPTIONAL.

# Separate the at-rest encryption key from the session key, so the session key
# can be rotated without destroying stored secrets. Unset, it is derived from
# AIPLANE_SESSION_KEY. Also 64 hex chars.
# AIPLANE_ENCRYPTION_KEY=

# The OIDC provider (issuer, client id, client secret) is configured in the
# setup wizard and stored encrypted in the database — it is NOT an env var.

# Backend API keys are entered at /admin/upstreams and stored encrypted in the
# database. A backend may instead name an environment variable to read its key
# from, in which case that variable belongs here.

# Break-glass admin: OIDC claim values that ALWAYS resolve to admin, whatever
# the database says. Comma-separated. It is the escape
# hatch for a broken group mapping, so it belongs here with the other
# break-glass material and not inside the database it rescues you from.
# AIPLANE_BOOTSTRAP_ADMIN_GROUPS=platform-admins

# Reverse proxies in front of AIplane, as comma-separated addresses or CIDR
# networks. Only a connection from one of them may name the real client through
# X-Forwarded-For / X-Real-IP; from anyone else those headers are ignored, so a
# visitor cannot forge an address to dodge a per-IP rate limit. Unset trusts
# none and every client IP is the TCP peer. With the proxy on the same host
# (Caddy, nginx) that is:
# AIPLANE_TRUSTED_PROXIES=127.0.0.1,::1

# Let URLs a user, a model or an agent's owner chooses (fetch_url, load_image_url,
# tls_cert, A2A routes, host_jwt JWKS URLs) reach private, loopback or CGNAT
# addresses (and, for agents, plain http). Off by default: only public hosts are
# reached. Link-local (cloud metadata) stays refused either way.
# AIPLANE_ALLOW_PRIVATE_NETWORKS=true

# Where the SQLite database lives. Only needed to override the path derived from
# AIPLANE_DATA_DIR (which the image already sets to the mounted volume). Opening
# the wrong database looks like a fresh install, so a wrong path serves an open
# setup wizard.
# AIPLANE_DB_PATH=/var/lib/gateway/gateway.sqlite
