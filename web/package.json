{
	"name": "gateway-web",
	"private": true,
	"version": "0.1.0",
	"description": "SvelteKit SPA (issue #22). adapter-static output is served by the gateway binary at /app from GATEWAY_STATIC_DIR; `vite dev` hot-reloads against the running gateway via the proxy in vite.config.ts.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.1.0",
		"daisyui": "^5.0.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.1.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
