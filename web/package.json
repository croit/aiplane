{
	"name": "aiplane-web",
	"private": true,
	"version": "0.1.0",
	"description": "The croit AIplane web UI. adapter-static output is served from AIPLANE_STATIC_DIR in production; local development exposes Vite HMR and every gateway route through one origin on port 8080.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:embed": "vite build -c vite.embed.config.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo && tsc -p embed/tsconfig.json"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.1.0",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"daisyui": "^5.7.50",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.1.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@zumer/snapdom": "^3.3.7",
		"dompurify": "^3.4.17",
		"marked": "^18.1.1"
	},
	"overrides": {
		"postcss-selector-parser": "7.1.6"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
