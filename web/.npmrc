engine-strict=true
legacy-peer-deps=true

# Do not run dependency lifecycle scripts on install. A postinstall script is
# arbitrary code from a transitive package executing on every developer machine
# and CI runner the moment it is installed — the standard delivery mechanism
# for a compromised npm release, and it fires before anything gets a chance to
# review the diff. The lockfile has exactly one package with an install script
# (fsevents, optional + macOS-only, and it ships prebuilt), so this costs us
# nothing. `npm run <script>` is unaffected: this only suppresses INSTALL-time
# lifecycle hooks, which also means our own `prepare` (svelte-kit sync) no
# longer fires on `npm ci` — mise's `web-install` task runs it explicitly.
ignore-scripts=true
