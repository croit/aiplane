#
# Gold workload image for the croit AIplane sandbox.
#
# Goal: a batteries-included environment so the model can act like a
# capable system engineer — debug large (and compressed) log files, work
# with office documents, convert between the common file formats, and
# generate diagrams (excalirender) and charts (Typst + gribouille) —
# without needing network access at runtime. The isolation is the OCI
# runtime it runs under (gVisor/runsc in production); the SAME image runs
# unchanged under any OCI runtime (runsc/crun/runc). The `sandbox-runner`
# boots one throwaway container per job from this image and pipes work to
# `/usr/local/bin/sandbox-agent`.
#
# It is deliberately large (LibreOffice + Chromium + data libs). Pull it
# once; runs are then cold-start only. amd64-targeted binary downloads
# (typst/duckdb/yq) match the production host; adjust for other arches.
#
# Build:
#   podman build -t ghcr.io/croit/aiplane-sandbox:latest sandbox-image/

# Base image is pinned by digest, not just by tag. `debian:trixie-slim` is a
# moving target — the same tag points at a new build every few days — so a tag
# alone means two builds of the same commit are not the same image, and a
# compromised or simply broken upstream push lands silently. The digest below
# is the multi-arch OCI index (not a per-platform manifest), so buildx still
# resolves the right architecture. Dependabot's docker ecosystem bumps the
# digest while keeping the tag readable; do not drop the tag, it is what makes
# the pin reviewable.
FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw \
    # Pin the Typst package cache to a shared, world-readable path so the
    # build (running as root) downloads packages into the SAME directory the
    # runtime (the unprivileged `sandbox` user) reads them from. This is what
    # makes the pre-warmed `@preview/gribouille` (+ its cetz backend) resolve
    # with NO network at runtime — see the diagram/chart layer below.
    TYPST_PACKAGE_CACHE_PATH=/opt/typst-packages

# --- System packages -------------------------------------------------------
# Grouped by purpose; --no-install-recommends keeps the (already large)
# image from ballooning further.
RUN apt-get update && apt-get install -y --no-install-recommends \
        # language runtimes + build toolchain (so pip can compile, and the
        # model can build/run small C programs like a real engineer)
        python3 python3-pip python3-venv \
        build-essential make pkg-config \
        # base utilities + networking/sysadmin
        ca-certificates curl wget git openssl \
        dnsutils iputils-ping netcat-openbsd rsync iproute2 \
        # packet-capture analysis (read uploaded .pcap/.pcapng; tshark = wireshark CLI)
        tshark tcpdump \
        # archives / (de)compression — logs ship gzip/zstd/bz2/xz, releases as 7z/zip
        xz-utils zstd bzip2 gzip zip unzip p7zip-full cpio tar \
        # log + text + data wrangling on the command line
        ripgrep grep gawk sed jq less file binutils xxd bsdextrautils \
        moreutils dateutils tree pv lnav sqlite3 \
        # office documents (writer/calc/impress/draw) + conversion/rendering
        # (pandoc is installed from an upstream .deb below — the distro package
        # lags far behind and its Typst reader / docx+odt writers are much older)
        libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-draw \
        weasyprint \
        # PDF tooling
        poppler-utils ghostscript qpdf \
        # images + media + fast image conversion
        ffmpeg imagemagick libvips-tools \
        # OCR (scanned docs/screenshots; eng+deu), diagrams, file-type sniffing
        tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu graphviz libmagic1 \
        # fonts for document/chart rendering (Latin + CJK + emoji)
        fonts-dejavu fonts-liberation fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji \
        # metric-compatible substitutes for the proprietary Office defaults
        # (Liberation above covers Arial/Times/Courier): Carlito = Calibri,
        # Caladea = Cambria, Comic Neue = Comic Sans
        fonts-crosextra-carlito fonts-crosextra-caladea fonts-comic-neue \
        # the most-used free document/brand fonts (Google-Fonts top list),
        # so generated PDFs/decks can match common corporate styles offline
        fonts-inter fonts-inter-variable fonts-roboto fonts-roboto-slab \
        fonts-open-sans fonts-lato fonts-montserrat fonts-quicksand fonts-cabin \
        fonts-ebgaramond fonts-paratype \
        # code fonts for listings in documents
        fonts-jetbrains-mono fonts-firacode \
        # fc-cache/fc-list for the google-fonts layer below (not guaranteed
        # via recommends with --no-install-recommends)
        fontconfig \
    && rm -rf /var/lib/apt/lists/*

# Fonts fetched from the google/fonts repo (all OFL) — families Debian
# doesn't package but that top every most-used list (decks, marketing,
# editorial), plus the monochrome Noto Emoji. Variable fonts where
# upstream ships one ([wght] carries every weight in one file); Poppins is
# static-only upstream, so its common cuts land individually.
#
# Noto Emoji (mono): fonts-noto-color-emoji is a CBDT *bitmap* font with
# no glyf/loca tables — reportlab's TTFont chokes on it ("missing location
# table"), so pure-reportlab PDFs could not render emoji at all. The
# outline variable font registers fine (family "Noto Emoji", distinct from
# "Noto Color Emoji", so fontconfig/typst/weasyprint keep preferring the
# color font for emoji fallback).
# NB: RUN uses /bin/sh (dash) — POSIX only, no bashisms. The local target
# name is passed explicitly (arg 3) instead of URL-decoding the source name.
# Files come straight off raw.githubusercontent.com: the github.com/<repo>/raw/
# redirect endpoint started answering 404 for every path in this repo, and it
# is a UI convenience route anyway — the raw host is the stable one.
#
# GOOGLE_FONTS_REF is a commit SHA, not `main`. A branch name makes the build
# unreproducible and, more to the point, means whatever is at the tip of a
# 4000-contributor repo at build time gets baked into the image unreviewed. A
# git commit SHA is a content address: the bytes behind it cannot change, which
# is a stronger guarantee than a per-file checksum list and far less to
# maintain. Bump it deliberately when a font needs updating.
ARG GOOGLE_FONTS_REF=809e4d8b8d7e9364a914909bb777679606c178b8
RUN set -eux; \
    gf() { mkdir -p "/usr/share/fonts/truetype/$1"; \
           curl -fsSL --retry 6 --retry-all-errors --retry-delay 3 \
                --connect-timeout 15 --max-time 180 \
                -o "/usr/share/fonts/truetype/$1/$3" \
                "https://raw.githubusercontent.com/google/fonts/${GOOGLE_FONTS_REF}/ofl/$1/$2"; }; \
    gf notoemoji "NotoEmoji%5Bwght%5D.ttf" "NotoEmoji.ttf"; \
    gf oswald "Oswald%5Bwght%5D.ttf" "Oswald.ttf"; \
    gf raleway "Raleway%5Bwght%5D.ttf" "Raleway.ttf"; \
    gf worksans "WorkSans%5Bwght%5D.ttf" "WorkSans.ttf"; \
    gf nunito "Nunito%5Bwght%5D.ttf" "Nunito.ttf"; \
    gf playfairdisplay "PlayfairDisplay%5Bwght%5D.ttf" "PlayfairDisplay.ttf"; \
    gf merriweather "Merriweather%5Bopsz,wdth,wght%5D.ttf" "Merriweather.ttf"; \
    gf poppins "Poppins-Regular.ttf" "Poppins-Regular.ttf"; \
    gf poppins "Poppins-Italic.ttf" "Poppins-Italic.ttf"; \
    gf poppins "Poppins-SemiBold.ttf" "Poppins-SemiBold.ttf"; \
    gf poppins "Poppins-Bold.ttf" "Poppins-Bold.ttf"; \
    # IBM Plex — a top corporate/document family. Debian only ships it in
    # `contrib` (not enabled on debian:trixie-slim), so fetch it here like the
    # other OFL families. Sans is a single [wdth,wght] variable file; Serif and
    # Mono are static upstream, so their common cuts land individually.
    gf ibmplexsans "IBMPlexSans%5Bwdth,wght%5D.ttf" "IBMPlexSans.ttf"; \
    gf ibmplexserif "IBMPlexSerif-Regular.ttf" "IBMPlexSerif-Regular.ttf"; \
    gf ibmplexserif "IBMPlexSerif-Italic.ttf" "IBMPlexSerif-Italic.ttf"; \
    gf ibmplexserif "IBMPlexSerif-Bold.ttf" "IBMPlexSerif-Bold.ttf"; \
    gf ibmplexserif "IBMPlexSerif-BoldItalic.ttf" "IBMPlexSerif-BoldItalic.ttf"; \
    gf ibmplexmono "IBMPlexMono-Regular.ttf" "IBMPlexMono-Regular.ttf"; \
    gf ibmplexmono "IBMPlexMono-Italic.ttf" "IBMPlexMono-Italic.ttf"; \
    gf ibmplexmono "IBMPlexMono-Bold.ttf" "IBMPlexMono-Bold.ttf"; \
    gf ibmplexmono "IBMPlexMono-BoldItalic.ttf" "IBMPlexMono-BoldItalic.ttf"; \
    chmod -R a+rX /usr/share/fonts/truetype; \
    fc-cache -f; \
    # loud sanity check: every family resolvable by fontconfig
    for fam in "Noto Emoji" Oswald Raleway "Work Sans" Nunito \
               "Playfair Display" Merriweather Poppins \
               "IBM Plex Sans" "IBM Plex Serif" "IBM Plex Mono"; do \
        fc-list | grep -qi "$fam" || { echo "font missing: $fam" >&2; exit 1; }; \
    done

# Pandoc, pinned to a recent upstream release. The Debian package lags badly;
# newer pandoc has a much-improved Typst reader and docx/odt writers (and adds
# `--typst-input` for sys.inputs). Used by `generate_document` and the
# typst -> HTML -> pandoc letter/one-pager docx/odt export. Static binary, no
# extra deps. Bump PANDOC_VERSION to upgrade.
ARG PANDOC_VERSION=3.11
ARG PANDOC_SHA256=89d4c9d97818c62a97157f0072844e4602c6cee795bf84abd1aee7273abcda99
RUN set -eux; \
    curl -fsSL -o /tmp/pandoc.deb \
        "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-1-amd64.deb"; \
    echo "${PANDOC_SHA256}  /tmp/pandoc.deb" | sha256sum -c - >/dev/null \
        || { echo "checksum mismatch for pandoc ${PANDOC_VERSION}" >&2; exit 1; }; \
    dpkg -i /tmp/pandoc.deb; \
    rm -f /tmp/pandoc.deb; \
    pandoc --version | head -1

# ImageMagick ships a hardened policy that blocks PDF/PS (a web-server
# concern); inside a single-use sandbox that just gets in the way of format
# conversion. Relax the PDF/PS coder restriction wherever the policy lives.
RUN for p in /etc/ImageMagick-*/policy.xml; do \
        [ -f "$p" ] && sed -i '/rights="none" pattern="\(PDF\|PS\|EPS\|XPS\)"/d' "$p" || true; \
    done

# --- Python libraries ------------------------------------------------------
# Install into a venv rather than the distro Python: trixie's Python is
# externally-managed, and `pip --break-system-packages` trips over
# dpkg-installed deps it can't cleanly upgrade ("uninstall-no-record-file").
# A venv is isolated and conflict-free; putting it first on PATH makes
# `python3`/`pip` resolve to it (so the agent's `python3 script` sees the libs).
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
# requirements.txt is a COMPILED lock: every package — direct and transitive —
# pinned to an exact version with every acceptable sha256, and installed under
# `--require-hashes` so pip refuses anything whose bytes do not match. The
# previous form (`pip install pandas numpy …`, unpinned) resolved live against
# PyPI at build time, which meant the image was not reproducible and a
# compromised release of ANY of the ~130 packages in the transitive closure
# would have been installed silently — into the one image whose entire purpose
# is executing model-authored code. Edit requirements.in and run
# `mise run lock-sandbox-python` to regenerate; never hand-edit this lock.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt \
    # playwright --with-deps installs browser OS libs via apt, so refresh the
    # package lists (wiped above) for the duration of this step.
    && apt-get update \
    && python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chmod -R a+rX /opt/venv /opt/pw

# typ2pptx fetches its `typst-ts-cli` helper on first use; the sandbox has NO
# network at runtime, so trigger that download now (network is available during
# build) by running a throwaway conversion. The binary lands in the package's
# data dir under /opt/venv and is cached in this layer. `|| true`: the helper
# download happens before any conversion quirk, so a non-zero convert exit must
# not fail the build.
RUN printf '= Warm up\n\nPre-fetching the typst-ts-cli helper.\n' > /tmp/warm.typ \
    && typ2pptx /tmp/warm.typ -o /tmp/warm.pptx >/dev/null 2>&1 || true; \
    rm -f /tmp/warm.typ /tmp/warm.pptx; \
    chmod -R a+rX /opt/venv

# --- Standalone CLI binaries (arch-aware) ----------------------------------
# typst, DuckDB CLI (SQL over CSV/JSON/Parquet — a workhorse for log/data
# debugging), and yq (YAML processor). TARGETARCH is provided by BuildKit
# (amd64 / arm64), so the image builds natively on both.
#
# All three are version-pinned AND sha256-verified. duckdb and yq used to use
# `releases/latest/download/...`, which means the image silently changes under
# you and a tampered or simply broken upstream artifact installs without
# complaint — in an image whose entire job is executing model-authored code.
# The checksums are per-arch because the artifacts are; `sha256sum -c` fails
# the BUILD rather than shipping an unverified binary. To upgrade: bump the
# VERSION arg and replace the matching hashes (the digests GitHub publishes on
# the release assets are the same values).
ARG TARGETARCH
ARG TYPST_VERSION=v0.15.1
ARG DUCKDB_VERSION=v1.5.5
ARG YQ_VERSION=v4.53.6
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
        amd64) typst_arch=x86_64;  dl_arch=amd64; \
               typst_sha=a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c; \
               duckdb_sha=08c0ca117111fcede14239d0093792352befdc174218c344d232c13279643d05; \
               yq_sha=c5f056448f973ae7d39b5401949648a78f2dc1947d6a8eb65be60d5c504b9385 ;; \
        arm64) typst_arch=aarch64; dl_arch=arm64; \
               typst_sha=5aa8d74a3d906e60ea12a66ac2f37f8eef1b14cbad7182a745e393a10c23dcee; \
               duckdb_sha=02163197027a42149147364d31fa67cac82108517a4be43304a1cc226eaef07a; \
               yq_sha=88a1016bc1d657375a35864e4f44b6f333df8ff97b559f51bba0adcb2169df09 ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    verify() { echo "$2  $1" | sha256sum -c - >/dev/null \
               || { echo "checksum mismatch for $1" >&2; exit 1; }; }; \
    curl -fsSL -o /tmp/typst.tar.xz \
        "https://github.com/typst/typst/releases/download/${TYPST_VERSION}/typst-${typst_arch}-unknown-linux-musl.tar.xz"; \
    verify /tmp/typst.tar.xz "$typst_sha"; \
    tar -xJ -C /tmp -f /tmp/typst.tar.xz; \
    install -m 0755 "/tmp/typst-${typst_arch}-unknown-linux-musl/typst" /usr/local/bin/typst; \
    rm -rf /tmp/typst.tar.xz /tmp/typst-*; \
    curl -fsSL -o /tmp/duckdb.zip \
        "https://github.com/duckdb/duckdb/releases/download/${DUCKDB_VERSION}/duckdb_cli-linux-${dl_arch}.zip"; \
    verify /tmp/duckdb.zip "$duckdb_sha"; \
    unzip -o /tmp/duckdb.zip -d /usr/local/bin; \
    rm /tmp/duckdb.zip; \
    curl -fsSL -o /tmp/yq \
        "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${dl_arch}"; \
    verify /tmp/yq "$yq_sha"; \
    install -m 0755 /tmp/yq /usr/local/bin/yq; \
    rm -f /tmp/yq; \
    typst --version; duckdb --version; yq --version

# --- Diagram + chart rendering (offline-capable) ---------------------------
# Two additions for "generate a diagram/chart and hand it back, or embed it
# in a Typst document":
#
#   * excalirender — converts an `.excalidraw` scene (which the model is good
#     at authoring) to SVG/PNG/PDF. A self-contained binary that bundles its
#     own libraries AND the hand-drawn Excalifont, so it needs no system deps
#     or network at runtime. `PREFIX=/usr/local` lands the launcher at
#     /usr/local/bin/excalirender (on the sandbox user's PATH).
#
#     excalirender is compiled with Bun, and Bun's event loop hangs forever
#     under gVisor (runsc, our production runtime): it probes io_uring /
#     pidfd_open, gVisor half-emulates them (setup succeeds but no events ever
#     arrive), and Bun never falls back to epoll — every render then dies on
#     the sandbox timeout (oven-sh/bun#16063, google/gvisor#11331). The fix is
#     the `noiou` launcher (noiou.c): it installs a seccomp filter forcing
#     those syscalls to a CLEAN ENOSYS — which makes Bun take its working epoll
#     fallback — then execs the real binary. The on-PATH `excalirender` is
#     re-pointed through it, so every call is covered. seccomp only removes
#     capability (never grants it) and lives wholly inside this image, so the
#     gVisor boundary and the OCI runtime are untouched.
#
#   * gribouille — a Grammar-of-Graphics (ggplot2-style) chart package for
#     Typst. Typst caches a package on first import and never re-downloads it,
#     so we render a real plot HERE (network available at build) to pull the
#     whole closure — gribouille + its cetz backend — into
#     $TYPST_PACKAGE_CACHE_PATH. At runtime the sandbox is offline; reading an
#     already-cached package needs no network. Same trick as the typ2pptx
#     helper warm-up above. The compile is intentionally NOT `|| true`: a
#     broken warm-up must fail the BUILD loudly rather than leave gribouille
#     unresolvable at runtime.
COPY noiou.c /tmp/noiou.c
# The release tarball is fetched and unpacked directly, with its sha256
# verified, rather than by piping upstream's install.sh into a shell. Two
# reasons: that script was read from the `main` branch, so a push to a personal
# repo — by its owner or by anyone who takes the account — would have executed
# as root inside this build with no review and no version to point at; and even
# pinned, an installer script can only ever be as trustworthy as the branch it
# is read from, while a checksummed artifact is verifiable. The steps below are
# exactly what install.sh did (unpack to $PREFIX/lib/excalirender, symlink into
# $PREFIX/bin) minus the api.github.com "latest" lookup, which was rate-limited
# on shared CI runner IPs and intermittently failed the build.
#
# Upstream ships a linux-x64 asset only, so this step (like install.sh's own
# arch check) is amd64-only. Bump VERSION and SHA256 together — the hash is the
# digest GitHub publishes on the release asset.
ARG EXCALIRENDER_VERSION=v1.10.5
ARG EXCALIRENDER_SHA256=4cc291bfb2cb6fb826e78693a73b3411e19b81616c8441825cc6745cd0f0d0e7
RUN set -eux; \
    curl -fsSL -o /tmp/excalirender.tar.gz \
        "https://github.com/JonRC/excalirender/releases/download/${EXCALIRENDER_VERSION}/excalirender-linux-x64.tar.gz"; \
    echo "${EXCALIRENDER_SHA256}  /tmp/excalirender.tar.gz" | sha256sum -c - >/dev/null \
        || { echo "checksum mismatch for excalirender ${EXCALIRENDER_VERSION}" >&2; exit 1; }; \
    tar xzf /tmp/excalirender.tar.gz -C /tmp; \
    rm -rf /usr/local/lib/excalirender; \
    mkdir -p /usr/local/lib/excalirender; \
    cp -r /tmp/excalirender/. /usr/local/lib/excalirender/; \
    ln -sf /usr/local/lib/excalirender/bin/excalirender /usr/local/bin/excalirender; \
    rm -rf /tmp/excalirender /tmp/excalirender.tar.gz; \
    excalirender --version; \
    # Build the seccomp launcher (build-essential is installed in the base
    # layer) and route the on-PATH `excalirender` through it. install.sh drops
    # a symlink at /usr/local/bin/excalirender -> the lib launcher; we replace
    # that symlink with a thin wrapper, leaving the upstream launcher (which
    # sets LD_LIBRARY_PATH/FONTCONFIG) pristine, so every invocation self-applies
    # the io_uring/pidfd ENOSYS filter before the Bun binary runs.
    gcc -O2 -o /usr/local/bin/noiou /tmp/noiou.c; \
    rm -f /tmp/noiou.c; \
    test -L /usr/local/bin/excalirender; \
    rm /usr/local/bin/excalirender; \
    printf '#!/bin/sh\nexec /usr/local/bin/noiou /usr/local/lib/excalirender/bin/excalirender "$@"\n' \
        > /usr/local/bin/excalirender; \
    chmod 0755 /usr/local/bin/excalirender; \
    # Smoke test: render a trivial scene THROUGH the wrapper. Proves noiou's
    # filter is accepted by the kernel and excalirender still emits output;
    # fails the BUILD loudly otherwise (same philosophy as the warm-up below).
    printf '{"type":"excalidraw","version":2,"source":"x","elements":[{"type":"rectangle","id":"a","x":0,"y":0,"width":80,"height":40,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100}]}' \
        > /tmp/smoke.excalidraw; \
    excalirender /tmp/smoke.excalidraw -o /tmp/smoke.svg; \
    test -s /tmp/smoke.svg; \
    rm -f /tmp/smoke.excalidraw /tmp/smoke.svg; \
    printf '#import "@preview/gribouille:0.7.0": *\n#plot(\n  data: penguins,\n  mapping: aes(x: "flipper-len", y: "body-mass"),\n  layers: (geom-point(),),\n)\n' \
        > /tmp/warm-chart.typ; \
    typst compile /tmp/warm-chart.typ /tmp/warm-chart.pdf; \
    rm -f /tmp/warm-chart.typ /tmp/warm-chart.pdf; \
    chmod -R a+rX /opt/typst-packages /usr/local/lib/excalirender /usr/local/bin/noiou /usr/local/bin/excalirender

# --- Agent + runtime user --------------------------------------------------
# The job marshaller the runner pipes RunRequest/RunResponse through.
COPY sandbox-agent /usr/local/bin/sandbox-agent
RUN chmod 0755 /usr/local/bin/sandbox-agent

# Defense-in-depth: strip every setuid/setgid bit. The job runs as a non-root
# user with no-new-privileges + cap-drop=ALL, so SUID binaries (mount, su,
# passwd, …) can't escalate anyway — removing the bit just deletes the surface.
# Run as root, before dropping to the sandbox user below.
RUN find / -xdev -type f -perm /6000 -exec chmod -s {} + 2>/dev/null || true

# Run as a non-root user. The runtime additionally drops all capabilities,
# mounts a read-only rootfs, and gives a tmpfs /work — see the runner's
# podman flags.
RUN useradd --create-home --uid 1001 --shell /usr/sbin/nologin sandbox \
    && mkdir -p /work && chown sandbox:sandbox /work
USER sandbox
WORKDIR /work

# The runner keeps pooled containers alive with `sleep infinity` and execs
# `sandbox-agent` per job; this default is just a sane fallback.
CMD ["sleep", "infinity"]
